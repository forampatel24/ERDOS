# ERDOS environment configuration.
# Copy to .env and fill in secrets. Never commit real secrets.

# --- General ---
ENV=development
PROJECT_NAME=ERDOS
VERSION=1.0.0
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# --- PostgreSQL / PostGIS ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=erdos
POSTGRES_PASSWORD=erdos
POSTGRES_DB=erdos
DATABASE_URL=postgresql+psycopg2://erdos:erdos@localhost:5432/erdos

# --- TimescaleDB ---
TIMESCALE_URL=postgresql+psycopg2://erdos:erdos@localhost:5432/erdos_timescale

# --- ChromaDB ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_PATH=./data/chromadb

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=erdos-backend

# --- Flink ---
FLINK_JOB_MANAGER_HOST=localhost
FLINK_JOB_MANAGER_PORT=8081

# --- Open-Meteo / Live sources ---
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
CWC_RIVER_API_URL=https://ffs.india-water.gov.in

# --- LLM ---
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
